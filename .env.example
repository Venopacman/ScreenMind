# ScreenMind Configuration
# Copy this to .env and adjust as needed

# Capture Settings
# CAPTURE_ON_START=true  # always start capturing on launch (default: restore last state)
# CAPTURE_ALL_MONITORS=false  # capture only one display (default: every display, one entry each)
CAPTURE_INTERVAL=30
SCREENSHOT_QUALITY=70
DATA_DIR=~/.screenmind

# Model Settings
GEMMA_MODE=local
# GEMMA_MODE=api  # WARNING: sends screenshots to Google AI Studio — disables local-only guarantee
# GOOGLE_API_KEY=your-key-here

# llama-server (local inference)
# NOTE: Do NOT set port in both LLAMA_SERVER_HOST and LLAMA_SERVER_PORT — they will silently diverge.
# LLAMA_SERVER_HOST=http://127.0.0.1:5809
# LLAMA_SERVER_PORT=5809

# Developer Context
WORKSPACE_DIRS=~/Projects,~/Desktop

# OCR languages. One script per frame, picked by the first non-English code; all read English.
# OCR_LANGUAGES=en,ru

# Privacy
BLOCKED_APPS=

# UI events (macOS, Windows): clicks, typed text, app switches, clipboard via accessibility APIs.
# macOS: needs Input Monitoring + Accessibility for the app that starts ScreenMind (e.g. Terminal).
# Windows: no permissions needed.
# UI_EVENTS_ENABLED=true
# UI_EVENTS_TYPES=click,app_switch
# EVENT_TRIGGERED_CAPTURE=true

# Hotkey
BOOKMARK_HOTKEY=ctrl+shift+b
